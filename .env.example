# --- MicroStrategy ---
MSTR_BASE_URL=https://tu-servidor/MicroStrategyLibrary
MSTR_USER=
MSTR_PASSWORD=
MSTR_PROJECT_ID=
# Opcional: carpeta por defecto para cubos nuevos (se puede pisar con folder_id=...)
MSTR_FOLDER_ID=
# 1 = standard, 16 = LDAP
MSTR_LOGIN_MODE=1

# --- Google ---
# service_account (default), oauth o adc (en Cloud Run: usa la cuenta de servicio del servicio)
GOOGLE_AUTH_MODE=service_account
# Ruta al JSON de la service account (modo service_account)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Ruta al client secret y al token cacheado (modo oauth)
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=token.json

# --- Google Cloud Storage ---
# Bucket por defecto para read_parquet (se puede pisar con bucket=...)
GCS_BUCKET=
